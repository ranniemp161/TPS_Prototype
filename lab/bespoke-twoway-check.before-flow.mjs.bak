// Restyle chat 3: the two way lines on steps 01, 03, 04.  node lab/bespoke-twoway-check.mjs <outdir>
// Taps both ends (label and line half), reads the checked radio, the fee, the
// circle's position against the stop; the night disable case; arrow keys.
import { chromium } from 'playwright-core';
import { pathToFileURL } from 'node:url';
const out = process.argv[2];
const b = await chromium.launch({ channel: 'chrome' });
const url = pathToFileURL(process.cwd() + '/index/build-your-programme.html').href;
let fails = 0;
const ok = (name, cond, info = '') => { if (!cond) fails++; console.log((cond ? 'ok   ' : 'FAIL ') + name + (info ? '  ' + info : '')); };
for (const [w, h] of [[1440, 900], [390, 844]]) {
  console.log('--- ' + w);
  const p = await b.newPage({ viewport: { width: w, height: h } });
  try { await p.goto(url, { timeout: 45000 }); } catch { await p.goto(url, { timeout: 60000 }); }
  await p.waitForLoadState('load'); await p.evaluate(() => document.fonts.ready); await p.waitForTimeout(1200);
  const go = async i => { await p.evaluate(i => { const d = document.querySelector('[data-deck]'); d.scrollTo({ left: i * d.clientWidth, behavior: 'instant' }); }, i); await p.waitForTimeout(700); };
  // Wait out the line's own transitions (650ms on a slow machine can run long).
  const settle = async () => { await p.waitForTimeout(150); await p.waitForFunction(() => !document.getAnimations().some(a => a.playState === 'running' && a.effect && a.effect.target && a.effect.target.closest && a.effect.target.closest('.dkl')), null, { timeout: 8000 }); };
  const val = n => p.evaluate(n => document.querySelector('input[name="' + n + '"]:checked').value, n);
  const fee = () => p.evaluate(() => document.querySelector('[data-fee]').textContent.trim());
  const geo = n => p.evaluate(n => {
    const g = document.querySelector('input[name="' + n + '"]').closest('.dkl');
    const c = e => { const r = g.querySelector(e).getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; };
    const ends = [...g.querySelectorAll('.dkl__end')].map(e => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return { h: Math.round(r.height), w: Math.round(r.width), op: s.opacity }; });
    const halves = [...g.querySelectorAll('.dkl__half')].map(e => Math.round(e.getBoundingClientRect().height) + 'x' + Math.round(e.getBoundingClientRect().width));
    const metas = [...g.querySelectorAll('.dkl__meta')].map(e => getComputedStyle(e).opacity);
    return { tip: c('.dkl__tip'), a: c('.dkl__stop--a'), b: c('.dkl__stop--b'), ends, halves, metas, overflow: document.documentElement.scrollWidth > innerWidth };
  }, n);
  const steps = [[1, 'format', ['in', 'out']], [3, 'shift', ['day', 'night']], [4, 'meals', ['yes', 'no']]];
  for (const [i, n, [va, vb]] of steps) {
    await go(i);
    const f0 = await fee();
    await p.click(`.dkl:has(input[name="${n}"]) .dkl__end--b`); await settle();
    const v1 = await val(n), f1 = await fee(), g1 = await geo(n);
    await p.screenshot({ path: `${out}/step0${i}-${w}-b.png` });
    ok(`${n}: tap ${vb} label`, v1 === vb && Math.abs(g1.tip[0] - g1.b[0]) < 0.5, `checked=${v1} fee ${f0} -> ${f1}; tip off stop b ${(g1.tip[0] - g1.b[0]).toFixed(2)}px; ends ${JSON.stringify(g1.ends)}; metas ${g1.metas}`);
    ok(`${n}: fee changed`, f1 !== f0);
    const ha = await p.$(`.dkl:has(input[name="${n}"]) .dkl__half--a`); const bb = await ha.boundingBox();
    await p.mouse.click(bb.x + bb.width * 0.3, bb.y + bb.height / 2); await settle();
    const v2 = await val(n), f2 = await fee(), g2 = await geo(n);
    ok(`${n}: tap line half a`, v2 === va && f2 === f0 && Math.abs(g2.tip[0] - g2.a[0]) < 0.5, `checked=${v2} fee ${f2}; tip off stop a ${(g2.tip[0] - g2.a[0]).toFixed(2)}px; halves ${g2.halves}; metas ${g2.metas}; overflowX ${g2.overflow}`);
    const hb = await p.$(`.dkl:has(input[name="${n}"]) .dkl__half--b`); const bb2 = await hb.boundingBox();
    await p.mouse.click(bb2.x + bb2.width * 0.7, bb2.y + bb2.height / 2); await settle();
    ok(`${n}: tap line half b`, (await val(n)) === vb && (await fee()) === f1);
    await p.focus(`input[name="${n}"]:checked`); await p.keyboard.press('ArrowLeft'); await settle();
    const v3 = await val(n), g3 = await geo(n);
    ok(`${n}: ArrowLeft`, v3 === va && Math.abs(g3.tip[0] - g3.a[0]) < 0.5 && (await fee()) === f0, `checked=${v3} tip off a ${(g3.tip[0] - g3.a[0]).toFixed(2)}px fee ${await fee()}`);
    await p.keyboard.press('ArrowRight'); await settle();
    const g4 = await geo(n);
    ok(`${n}: ArrowRight`, (await val(n)) === vb && Math.abs(g4.tip[0] - g4.b[0]) < 0.5 && (await fee()) === f1, `tip off b ${(g4.tip[0] - g4.b[0]).toFixed(2)}px`);
    await p.keyboard.press('ArrowLeft'); await settle();
    if (w === 1440) await p.screenshot({ path: `${out}/step0${i}-${w}-focus.png` });
    await p.evaluate(() => document.activeElement.blur());
  }
  // Night disable: day and night chosen, then daytime in-home on 01; 03's night end is disabled.
  await go(3); await p.click('.dkl:has(input[name="shift"]) .dkl__end--b'); await p.waitForTimeout(700);
  await go(1); await p.click('.dkl:has(input[name="format"]) .dkl__end--b'); await p.waitForTimeout(700);
  await go(3); await p.waitForTimeout(300);
  const d = await p.evaluate(() => { const i = document.querySelector('input[name="shift"][value="night"]'); const e = i.closest('.dkl__end'); return { disabled: i.disabled, op: getComputedStyle(e).opacity, pe: getComputedStyle(e).pointerEvents, half: getComputedStyle(e.closest('.dkl').querySelector('.dkl__half--b')).pointerEvents, band: !document.querySelector('[data-night-band]').hidden, shift: document.querySelector('input[name="shift"]:checked').value }; });
  ok('night forced back to day and disabled', d.disabled && d.shift === 'day' && d.op === '0.3' && d.pe === 'none' && d.half === 'none' && d.band, JSON.stringify(d));
  const g5 = await geo('shift'); ok('circle followed the forced day', Math.abs(g5.tip[0] - g5.a[0]) < 0.5);
  const fd = await fee();
  const nc = await p.evaluate(() => { const r = document.querySelector('[data-night-choice]').getBoundingClientRect(); return [r.left + r.width / 2, r.top + r.height / 2]; });
  await p.mouse.click(nc[0], nc[1]);
  const hb = await p.$('.dkl:has(input[name="shift"]) .dkl__half--b'); const bb3 = await hb.boundingBox();
  await p.mouse.click(bb3.x + bb3.width * 0.7, bb3.y + bb3.height / 2); await p.waitForTimeout(700);
  ok('disabled night end untappable', (await val('shift')) === 'day' && (await fee()) === fd, 'fee ' + fd);
  await p.screenshot({ path: `${out}/step03-${w}-disabled.png` });
  await go(1); await p.click('.dkl:has(input[name="format"]) .dkl__end--a'); await p.waitForTimeout(700);
  await go(3); ok('night open again on live-in', !(await p.evaluate(() => document.querySelector('input[name="shift"][value="night"]').disabled)));
  for (const i of [1, 3, 4]) { await go(i); await p.screenshot({ path: `${out}/step0${i}-${w}.png` }); }
  await p.close();
}
await b.close();
console.log(fails ? fails + ' FAILED' : 'all passed');
